{
  "name": "indian-store-backend",
  "version": "1.0.0",
  "description": "Enterprise E-Commerce Backend with Node.js, Express, Keycloak, PostgreSQL, Redis, and BullMQ",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:schema": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:clear": "tsx src/database/clear.ts",
    "db:reset": "npm run db:clear && npm run db:seed",
    "test": "vitest run"
  },
  "dependencies": {
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "sharp": "^0.35.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
