PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4200

# PostgreSQL Configuration
DATABASE_URL=postgresql://store_admin:store_secure_password_2026@localhost:5432/indian_store_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=indian_store_db
PGUSER=store_admin
PGPASSWORD=store_secure_password_2026

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Keycloak Configuration (IAM)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=indian-store-realm
KEYCLOAK_CLIENT_ID=indian-store-api
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/indian-store-realm/protocol/openid-connect/certs

# Dev Mode Bypass Auth (allows mock JWT when Keycloak is offline)
DEV_AUTH_BYPASS=true

# Notification Provider Keys (Placeholders)
RESEND_API_KEY=re_placeholder_123
TWILIO_ACCOUNT_SID=AC_placeholder_123
TWILIO_AUTH_TOKEN=auth_placeholder_123
WHATSAPP_API_TOKEN=wa_placeholder_123
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
