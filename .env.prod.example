# Let's Encrypt SSL Email (for expiration notices & SSL registration)
ACME_EMAIL=admin@trader-news.co.in

# ==========================================
# POSTGRESQL CREDENTIALS
# ==========================================
DB_NAME=indian_store_db
DB_USER=store_admin
DB_PASSWORD=store_prod_secure_pass_2026

# ==========================================
# KEYCLOAK IAM CREDENTIALS
# ==========================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_prod_pass_2026
KEYCLOAK_REALM=indian-store
