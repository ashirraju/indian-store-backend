# ==========================================
# PRODUCTION DOMAIN CONFIGURATION
# ==========================================
API_DOMAIN=indian-store-api.trader-news.co.in
KEYCLOAK_DOMAIN=indian-store-auth.trader-news.co.in
FRONTEND_DOMAIN=indian-store.trader-news.co.in
PGADMIN_DOMAIN=indian-store-db.trader-news.co.in

# Let's Encrypt SSL Email (for expiration notices & SSL registration)
ACME_EMAIL=admin@trader-news.co.in

# ==========================================
# POSTGRESQL CREDENTIALS
# ==========================================
DB_NAME=indian_store_db
DB_USER=store_admin
DB_PASSWORD=store_prod_secure_pass_2026

# ==========================================
# KEYCLOAK IAM CREDENTIALS
# ==========================================
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_admin_prod_pass_2026
KEYCLOAK_REALM=indian-store
KEYCLOAK_CLIENT_ID=indian-store-public

# ==========================================
# PGADMIN CREDENTIALS
# ==========================================
PGADMIN_EMAIL=admin@trader-news.co.in
PGADMIN_PASSWORD=pgadmin_admin_prod_pass_2026

# ==========================================
# MEDIA / STATIC ASSET HOSTING (VPS + CLOUDFLARE)
# ==========================================
PUBLIC_ASSET_URL=https://indian-store-api.trader-news.co.in
UPLOADS_PATH=/app/uploads

# ==========================================
# ZOHO CATALYST STRATUS OBJECT STORAGE
# ==========================================
ZOHO_STRATUS_ENABLED=true
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_REFRESH_TOKEN=your_refresh_token
ZOHO_STRATUS_BUCKET=indian-store-images
ZOHO_STRATUS_BUCKET_URL=https://indian-store-images-development.zohostratus.com

