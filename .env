KEYCLOAK_REALM=indian-store-realm
KEYCLOAK_CLIENT_ID=indian-store-api
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/indian-store-realm/protocol/openid-connect/certs

# Dev Mode Bypass Auth (allows mock JWT when Keycloak is offline)
DEV_AUTH_BYPASS=true

# Notification Provider Keys (Placeholders)
